# Copie para .env.local e preencha com os valores reais do seu projeto Supabase.
# Nunca commite .env.local.

# --- Supabase (expostos ao browser — só anon key, nunca service role) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# --- Supabase service role (SOMENTE servidor — nunca em NEXT_PUBLIC_*) ---
SUPABASE_SERVICE_KEY=sua-service-key-aqui

# Alias para os testes de isolamento RLS (aponta para o mesmo projeto)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# URL pública da app — usada no link do e-mail de convite de nova conta
# Produção (Vercel): https://seuapp.vercel.app | Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago — assinatura recorrente do SaaS (Preapproval)
# Obtido em developers.mercadopago.com → Credenciais
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx
# Secret para validar assinatura do webhook (painel MP → Webhooks)
MP_WEBHOOK_SECRET=sua-chave-secreta-webhook

# Resend — e-mail transacional
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret do webhook: painel Resend → Webhooks → Signing Secret
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# uazapi — WhatsApp REST (supercloudstore.uazapi.com ou instância própria)
# Usado em forcarEnvioAction (log/page), na tela de conexão e no cron uazapi
UAZAPI_URL=https://supercloudstore.uazapi.com
UAZAPI_ADMIN_TOKEN=seu-admin-token-uazapi
# Alias legado de UAZAPI_ADMIN_TOKEN (log.ts cai neste se o primeiro não existir) — normalmente não precisa setar os dois
UAZAPI_GLOBAL_TOKEN=
# Segredo para validar webhooks da uazapi — inclua como ?secret=TOKEN na URL do webhook
# Gerar: openssl rand -hex 32
UAZAPI_WEBHOOK_SECRET=gere-com-openssl-rand-hex-32

# Segredo dos crons (/api/cron/*) — cron-job.org e o vercel.json enviam
# Authorization: Bearer <CRON_SECRET>. Mesmo valor já usado em /api/cron/whatsapp.
# Gerar: openssl rand -hex 32
CRON_SECRET=gere-com-openssl-rand-hex-32

# Segredo do webhook de PIX da EfiBank (?token=... na URL cadastrada na EfiBank).
# Opcional: sem ele o webhook aceita o CRON_SECRET (legado) — mas essa URL aparece em logs de acesso,
# então um segredo próprio evita que um vazamento comprometa também os crons.
# Gerar: openssl rand -hex 32
EFIBANK_WEBHOOK_SECRET=

# Mercado Pago como provedor de PIX do CLIENTE FINAL (cada conta cola, em Configurações, o Access
# Token E o Webhook Secret da PRÓPRIA conta Mercado Pago — não há segredo de app aqui, diferente da
# EfiBank/uazapi acima: a Orders API não aceita notification_url por requisição, então cada conta
# configura a URL fixa https://SEU-DOMINIO/api/webhooks/mercadopago-pix no próprio painel Mercado
# Pago ("Suas integrações" → Webhooks) e cola a Secret Key gerada lá. Nada a configurar aqui.

# Chave que cifra credenciais de integração guardadas no banco (hoje: Access Token e Webhook Secret do Mercado Pago dos clientes).
# 32 bytes em base64. OBRIGATÓRIA para salvar o token. Trocar/perder a chave invalida os tokens já salvos
# (os donos das contas precisam colar de novo) — guarde uma cópia em cofre de senhas.
# Gerar: openssl rand -base64 32
CREDENCIAIS_KEY=

# Segredo para assinar links de descadastro de e-mail (unsubscribe)
# Gerar: openssl rand -hex 32
UNSUB_SECRET=gere-com-openssl-rand-hex-32
