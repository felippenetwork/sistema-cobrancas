# Copie para .env.local e preencha com os valores reais do seu projeto Supabase.
# Nunca commite .env.local.

# --- Supabase (expostos ao browser — só anon key, nunca service role) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# --- Supabase service role (SOMENTE servidor — nunca em NEXT_PUBLIC_*) ---
SUPABASE_SERVICE_KEY=sua-service-key-aqui

# Alias para os testes de isolamento RLS (aponta para o mesmo projeto)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# URL pública da app — usada no link do e-mail de convite de nova conta
# Produção (Vercel): https://seuapp.vercel.app | Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago — assinatura recorrente do SaaS (Preapproval)
# Obtido em developers.mercadopago.com → Credenciais
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx
# Secret para validar assinatura do webhook (painel MP → Webhooks)
MP_WEBHOOK_SECRET=sua-chave-secreta-webhook

# Resend — e-mail transacional
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret do webhook: painel Resend → Webhooks → Signing Secret
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# uazapi — WhatsApp REST (supercloudstore.uazapi.com ou instância própria)
# Usado em forcarEnvioAction (log/page) e na tela de conexão
UAZAPI_URL=https://supercloudstore.uazapi.com
UAZAPI_ADMIN_TOKEN=seu-admin-token-uazapi
# Segredo para validar webhooks da uazapi — inclua como ?secret=TOKEN na URL do webhook
# Gerar: openssl rand -hex 32
UAZAPI_WEBHOOK_SECRET=gere-com-openssl-rand-hex-32

# Segredo para assinar links de descadastro de e-mail (unsubscribe)
# Deve ser IDÊNTICO ao UNSUB_SECRET configurado no worker (Vortexus)
# Gerar: openssl rand -hex 32
UNSUB_SECRET=gere-com-openssl-rand-hex-32
