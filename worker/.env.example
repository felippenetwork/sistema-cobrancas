# Supabase — service role (bypassa RLS; nunca expor)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sua-service-role-key-aqui

# Resend — envio de e-mail
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# URL pública do sistema (para links de unsubscribe nos e-mails)
SITE_URL=https://cobranx.site

# uazapi — gerenciamento de conexão WhatsApp
UAZAPI_URL=https://supercloudstore.uazapi.com
UAZAPI_ADMIN_TOKEN=seu-admin-token-aqui

# Health check HTTP (padrão 3001)
HEALTH_PORT=3001

# Log level: silent | error | warn | info | debug
LOG_LEVEL=warn
